# Copy to .env.local and adjust. EXPO_PUBLIC_* values are inlined at build time.
# On a phone, "localhost" is the phone itself: use your computer's LAN address and run the
# backend with `uvicorn app.main:app --reload --host 0.0.0.0`.

# REST base (must include /api/v1) and WebSocket base (must include /ws/v1) — same as the website.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://192.168.1.20:8000/ws/v1

# The website, for personal room links (<web>/r/<key>). Optional: learned from join links.
EXPO_PUBLIC_WEB_URL=http://192.168.1.20:3000

# Sent as the WebSocket Origin. Must be listed in the backend's WS_ALLOWED_ORIGINS.
EXPO_PUBLIC_WS_ORIGIN=droply-app://mobile

# Diagnostics panel in rooms, and the loopback benchmark (Settings → Benchmark).
EXPO_PUBLIC_DEBUG=false
EXPO_PUBLIC_ENABLE_BENCHMARK=false

# Unfinished transfers this device keeps open on the server at once (backend limit is 20).
EXPO_PUBLIC_MAX_ACTIVE_TRANSFERS=16

# Production example:
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
# EXPO_PUBLIC_WS_URL=wss://api.example.com/ws/v1
# EXPO_PUBLIC_WEB_URL=https://example.com
